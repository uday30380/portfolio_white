rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly allow public to create messages with strict schema validation
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if request.auth != null;
    }

    // Publicly readable settings (like Announcements)
    match /settings/global_announcement {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read access to portfolio content
    match /content/portfolioData {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read access to resume data; write restricted to authenticated admin
    match /resume/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow visitor counter read and validated write
    match /stats/{statId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['count'])
                   && request.resource.data.count is int;
    }
    
    // Other collections (default lock-down: authenticated admins only)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
